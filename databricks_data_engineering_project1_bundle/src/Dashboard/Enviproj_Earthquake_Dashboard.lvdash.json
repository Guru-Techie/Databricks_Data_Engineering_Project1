{
  "datasets": [
    {
      "name": "5e1381b0",
      "displayName": "EarthQuake_Detail",
      "queryLines": [
        "select * from enviproj_prod.silver.earthquake_data_final"
      ],
      "catalog": "enviproj_prod",
      "schema": "silver"
    },
    {
      "name": "6d4d286b",
      "displayName": "EarthQuake_Type",
      "queryLines": [
        "select count(*) as total_magnitude_bucket\r\n",
        ",magnitude_bucket from (select CASE\r\n",
        "WHEN mag < 2 THEN 'Micro (<2)'\r\n",
        "WHEN mag BETWEEN 2 AND 3 THEN 'Minor (2-3)'\r\n",
        "WHEN mag BETWEEN 3 AND 4 THEN 'Light (3-4)'\r\n",
        "ELSE 'Moderate+ (4+)'\r\n",
        "END AS magnitude_bucket\r\n",
        "from enviproj_prod.silver.earthquake_data_final )\r\n",
        "\r\n",
        "group by magnitude_bucket"
      ],
      "catalog": "enviproj_prod",
      "schema": "silver"
    },
    {
      "name": "f818c485",
      "displayName": "Global Earthquake Events Grouped by Country",
      "queryLines": [
        "SELECT\r\n",
        "    count(*) AS event_count,\r\n",
        " --   CASE\r\n",
        " --      WHEN size(split(place,', ')) = 1 THEN split(place, ', ') [0]\r\n",
        " --      ELSE split(place, ',')[1]\r\n",
        " --   END AS country\r\n",
        "    get(split(place, ','), 1) AS country\r\n",
        "FROM (\r\n",
        "    SELECT\r\n",
        "        time,\r\n",
        "        title,\r\n",
        "        mag,\r\n",
        "        longitude,\r\n",
        "        place,\r\n",
        "        latitude\r\n",
        "        FROM enviproj_prod.silver.earthquake_data_final\r\n",
        ")   \r\n",
        "GROUP BY country\r\n"
      ],
      "catalog": "enviproj_prod",
      "schema": "silver"
    }
  ],
